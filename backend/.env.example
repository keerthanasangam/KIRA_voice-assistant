# ==================================================
# KIRA Backend Environment Configuration Template
# Duplicate this file as .env and fill in your values.
# NEVER commit the real .env with secrets to Git.
# ==================================================

# --------------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------------
# Option A: Direct full connection string (Recommended for hosted providers: Render, Supabase, Neon)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Option B: Individual connection components (Default for local PostgreSQL)
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kira_db

# --------------------------------------------------
# Google Gemini AI Configuration
# --------------------------------------------------
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
KIRA_MODEL=gemini-3-flash-preview

# --------------------------------------------------
# Application & Security Settings
# --------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed frontend production origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------
# Optional: Twilio Voice / Telephony Webhook
# --------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
